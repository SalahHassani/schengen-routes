generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  CLOSED
  SPAM
}

model Enquiry {
  id                   String        @id @default(cuid())
  referenceNumber      String        @unique @map("reference_number") @db.VarChar(32)
  fullName             String        @map("full_name") @db.VarChar(120)
  email                String        @db.VarChar(180)
  service              String        @db.VarChar(40)
  subject              String        @db.VarChar(160)
  message              String        @db.Text
  countryOfResidence   String?       @map("country_of_residence") @db.VarChar(100)
  destinationCountry   String?       @map("destination_country") @db.VarChar(100)
  preferredContact     String?       @map("preferred_contact") @db.VarChar(20)
  status               EnquiryStatus @default(NEW)
  privacyAcknowledged  Boolean       @default(false) @map("privacy_acknowledged")
  assignedTo           String?       @map("assigned_to") @db.VarChar(120)
  internalNotes        String?       @map("internal_notes") @db.Text
  lastRespondedAt      DateTime?     @map("last_responded_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt], name: "idx_enquiries_status_created_at")
  @@index([service, createdAt], name: "idx_enquiries_service_created_at")
  @@index([email], name: "idx_enquiries_email")
  @@map("enquiries")
}

